# Development happens in WSL2/Linux. Normalise everything to LF in the repository
# so Windows checkouts never introduce CRLF into committed files — Snakemake and
# shell scripts break on CRLF.

* text=auto eol=lf

# Shell and workflow files must be LF, no exceptions.
*.sh        text eol=lf
*.smk       text eol=lf
Snakefile   text eol=lf
*.jl        text eol=lf

# Binary — never touch.
*.png       binary
*.jpg       binary
*.pdf       binary
*.nc        binary
*.parquet   binary
*.zip       binary
*.gdb       binary

# Fixed-width CEPEL deck files: byte-exact layout is semantic. Do not normalise.
*.dat       -text
*.DAT       -text
